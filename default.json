{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "automerge": false,
  "ignoreTests": false,
  "timezone": "America/Los_Angeles",
  "schedule": [
    "* 5-8 * * 1-5"
  ],
  "packageRules": [
    {
      "description": "Renovate creates and updates dependency PRs; the external steward is the sole merge authority",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major",
        "digest",
        "pinDigest",
        "pin"
      ],
      "automerge": false
    },
    {
      "description": "Gate Biome toolchain updates; new diagnostics often require a safe formatting/import pass",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "groupName": "biome toolchain",
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the TypeScript compiler and ESLint TypeScript parser stack together",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript",
        "typescript-eslint",
        "@typescript-eslint/*"
      ],
      "groupName": "typescript-eslint toolchain",
      "rangeStrategy": "bump"
    },
    {
      "description": "Pin Docker tags to immutable digests",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "pinDigests": true
    },
    {
      "description": "Use digest-specific branches so moving Docker tags create a new PR per resolved digest",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "branchTopic": "{{{depNameSanitized}}}-{{{currentValue}}}-{{{newDigestShort}}}"
    },
    {
      "description": "Lockfile maintenance unaffected by minimumReleaseAge (package-manager-controlled)",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Package replacements unaffected by minimumReleaseAge (Renovate limitation - issue #39400)",
      "matchUpdateTypes": [
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Docker digest updates cannot resolve a release timestamp on moving tags. Renovate may create the PR without its native age check, but the external steward must enforce the immutable 14-day first-seen gate before merge.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Pin update types do not wire in Renovate release age (issue #40288). The external steward must enforce a trusted 14-day registry-release gate, or immutable first-seen when no trustworthy publish timestamp exists, before merge.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Majors: rebase only on conflict \u2014 a red major otherwise rebases every schedule window, re-running CI and re-firing failure email for weeks (spicy-tools 07-22..08-20). New releases still update the PR.",
      "matchUpdateTypes": [
        "major"
      ],
      "rebaseWhen": "conflicted"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "ansible/runtime-versions\\.ya?ml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+\\w+_version:\\s+[\"']?(?<currentValue>.+?)[\"']?$"
      ]
    }
  ],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "prCreation": "immediate"
}
